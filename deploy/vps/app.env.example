# Outings server configuration. The real file is /etc/outings/app.env on the server
# (root only, chmod 600). setup-server.sh creates it from this template and fills in the
# generated values. Edit it with:   nano /etc/outings/app.env
# Apply changes with:               bash /opt/outings/deploy/vps/deploy.sh
# Never commit the real file. Write values without quotes.

# --- Filled in by setup-server.sh ----------------------------------------------
SITE_ADDRESS=
APP_BASE_URL=
POSTGRES_PASSWORD=
SESSION_SECRET=
MERCHANT_DASHBOARD_PASSWORD=

# --- Fixed for the hosted demo ---------------------------------------------------
# Judge mode: labelled FIXTURE modes, demo hub, persona switching (sandbox data only).
DEMO_FIXTURES_ENABLED=true
# Caddy is the one proxy in front of the app.
TRUSTED_PROXY_HOPS=1
PAYPAL_ENV=sandbox
OUTINGS_AI_MODEL=claude-sonnet-5-5
# CRON_SECRET stays unset: the worker container settles deadlines, so the
# /api/cron/tick endpoint is switched off (it answers 503 in production without it).

# --- You paste these (docs/DEPLOYMENT.md, step 5) ----------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
# After registering the webhook (docs/DEPLOYMENT.md, step 7):
PAYPAL_WEBHOOK_ID=
# A key created in a Claude Console workspace that has a monthly spend limit:
OUTINGS_ANTHROPIC_API_KEY=
# Judge sign-in (/judge/login). With JUDGE_PASSWORD set, only signed-in judges can create real outings
# or reach Claude; everyone else gets the free /demo. Use at least 16 characters, and give the
# username and password to the judges in the Devpost testing instructions. Empty = no sign-in at all.
JUDGE_USERNAME=judge
JUDGE_PASSWORD=
# Optional. Empty = AG Studio trial mode:
AG_STUDIO_LICENSE_KEY=
