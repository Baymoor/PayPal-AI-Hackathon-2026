# Outings — environment contract. Copy to .env.local and fill in. NEVER commit real values.
# Read by Next.js and by the npm scripts (db:migrate, db:seed, demo:reset, worker); shell variables win.

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgres://outings:outings@localhost:5432/outings
APP_BASE_URL=http://localhost:3000
# 32+ random bytes, e.g. `openssl rand -hex 32`. Signs participant/merchant session cookies.
# Required in production. Empty locally = a random secret per process (demo sessions reset on restart).
SESSION_SECRET=
# Bearer secret for the scheduler endpoint POST /api/cron/tick (empty = open only in demo mode outside production)
CRON_SECRET=
# Enables clearly-labelled FIXTURE payment/AI modes, demo seed and persona links.
DEMO_FIXTURES_ENABLED=true
# Password for the merchant dashboard (in demo mode a one-click demo sign-in is also offered)
MERCHANT_DASHBOARD_PASSWORD=
# Judge sign-in at /judge/login. Empty password = no sign-in (everyone may create outings and reach Claude).
# Set (16+ characters) = only signed-in judges create outings, use the AG Studio assistant or reach Claude.
JUDGE_USERNAME=judge
JUDGE_PASSWORD=
# Number of reverse proxies in front of the app that append to X-Forwarded-For (0-10).
# Rate limits key on the N-th X-Forwarded-For entry from the right (then X-Real-IP).
# 0 (default) trusts no forwarding header: all clients share one bucket per route.
# Typical: 1 behind a single platform load balancer. See docs/DEPLOYMENT.md.
TRUSTED_PROXY_HOPS=0

# --- PayPal (sandbox only) ---------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional fallback payee: sandbox merchant ID of the experience merchant (an email works
# for orders but may fail the authorization payee check). The payee is the outing merchant's
# merchants.paypal_merchant_id; this is used only when that column is empty
# (`npm run db:seed` copies it into the demo merchant).
PAYPAL_MERCHANT_ID=

# --- AG Studio ---------------------------------------------------------------
AG_STUDIO_LICENSE_KEY=

# --- Anthropic (runtime AI for the app; separate from any Claude Code credits) -
OUTINGS_ANTHROPIC_API_KEY=
OUTINGS_AI_MODEL=claude-sonnet-5-5
