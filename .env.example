# Outings — environment contract. Copy to .env.local and fill in. NEVER commit real values.

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgres://outings:outings@localhost:5432/outings
APP_BASE_URL=http://localhost:3000
# 32+ random bytes, e.g. `openssl rand -hex 32`. Signs participant/merchant session cookies.
SESSION_SECRET=
# Bearer secret for the scheduler endpoint POST /api/cron/tick
CRON_SECRET=
# Enables clearly-labelled FIXTURE payment/AI modes, demo seed and persona links.
DEMO_FIXTURES_ENABLED=true
# Password for the merchant dashboard (in demo mode a one-click demo sign-in is also offered)
MERCHANT_DASHBOARD_PASSWORD=

# --- PayPal (sandbox only) ---------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional: sandbox merchant id / email of the experience merchant (payee check)
PAYPAL_MERCHANT_ID=

# --- AG Studio ---------------------------------------------------------------
AG_STUDIO_LICENSE_KEY=

# --- Anthropic (runtime AI for the app; separate from any Claude Code credits) -
OUTINGS_ANTHROPIC_API_KEY=
OUTINGS_AI_MODEL=claude-sonnet-5-5
